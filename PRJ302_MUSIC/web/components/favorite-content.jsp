<%@page contentType="text/html" pageEncoding="UTF-8"%>

<section class="favorite-page">

    <div class="favorite-header">

        <div class="favorite-cover">
            <div class="heart-icon">❤️</div>
        </div>

        <div class="favorite-info">
            <span class="playlist-label">Playlist · 0 Songs</span>
            <h1>Favorite Songs</h1>
            <p>and more</p>

            <div class="favorite-actions">
                <button class="favorite-btn">▶ Play all</button>
                <button class="favorite-btn">⬇ Download</button>
            </div>

            <button class="favorite-btn">Add songs</button>
        </div>

    </div>

    <div class="favorite-empty">
        <div class="empty-icon">📦</div>
        <h3>It's empty here</h3>
        <p>Choose some songs to add to this playlist</p>
        <button class="btn-add">Add songs</button>
    </div>

</section>
